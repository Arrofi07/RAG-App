# .env.example — copy to .env and fill in your values
#
# ═══════════════════════════════════════════════════════════════════════════
# LLM PROVIDER ROUTING (v9)
# ═══════════════════════════════════════════════════════════════════════════
# Three independent roles, each can use a different provider:
#   enrichment — contextual chunk summaries during PDF ingestion (frequent, small)
#   planning   — query rewriting, intent classification, search queries (frequent, small)
#   answer     — final answer shown to the student (infrequent, needs best quality)
#
# DEFAULT SETUP (recommended for M2 / 8 GB):
#   enrichment + planning → local Ollama (Qwen3:1.7b) — completely free, no quota
#   answer                → Gemini cascade             — best quality for the student
# ═══════════════════════════════════════════════════════════════════════════

# ── Gemini (used for "answer" role by default, and web search grounding) ──────
GEMINI_API_KEY=AQ.Ab8RN6LOiEDgTpxCCt-a4ny9zpgDwoke3PDftOxifBzYH89i1g
# Ollama private key: ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEaop8DruMFD1PlERaZmd3W3IZdrBSERblTv1hqdjUe/

# ── Role: enrichment (contextual chunk summaries at ingest time) ──────────────
ENRICHMENT_PROVIDER=ollama
ENRICHMENT_MODEL=qwen3:1.7b

# ── Role: planning (query rewrite, intent classification, search queries) ────
PLANNING_PROVIDER=ollama
PLANNING_MODEL=qwen3:1.7b

# ── Role: answer (final student-facing response) ──────────────────────────────
ANSWER_PROVIDER=gemini
# Comma-separated cascade — tries each in order if rate-limited
ANSWER_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# ── Ollama connection (only used if any role above = "ollama") ────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# ── OpenAI-compatible providers (only used if any role above = one of these) ──
# Set OPENAI_API_KEY and optionally OPENAI_BASE_URL for whichever you use.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1     # DeepSeek
# OPENAI_BASE_URL=https://api.moonshot.cn/v1      # Kimi / Moonshot
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # cloud Qwen

# ── Retry / rate-limit tuning (applies mainly to GeminiProvider) ──────────────
LLM_MAX_RETRIES=2
LLM_503_BACKOFF=5
LLM_MIN_429_DELAY=5
LLM_429_PER_MODEL_MAX=3

# ── Vector store ────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Embedding / reranking models (local, via FlagEmbedding) ───────────────────
LOCAL_EMBED_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Contextual enrichment batching (ingestion) ─────────────────────────────────
CONTEXT_BATCH_SIZE=20
CONTEXT_INTER_BATCH_DELAY=0

# ── Conversation history ───────────────────────────────────────────────────────
MAX_HISTORY_TURNS=10

# ═══════════════════════════════════════════════════════════════════════════
# ALTERNATIVE CONFIGURATIONS — uncomment the block you want
# ═══════════════════════════════════════════════════════════════════════════

# ── Option A: Everything local (zero cloud cost, needs more RAM/time) ─────────
# ENRICHMENT_PROVIDER=ollama
# ENRICHMENT_MODEL=qwen3:1.7b
# PLANNING_PROVIDER=ollama
# PLANNING_MODEL=qwen3:1.7b
# ANSWER_PROVIDER=ollama
# ANSWER_MODELS=qwen3:8b
# NOTE: qwen3:8b needs ~5 GB RAM — tight alongside bge-m3 + reranker on 8 GB.
# Consider unloading the reranker model or using a smaller answer model.

# ── Option B: DeepSeek for answers instead of Gemini ──────────────────────────
# ANSWER_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# ANSWER_MODELS=deepseek-chat

# ── Option C: Kimi (Moonshot) for answers ──────────────────────────────────────
# ANSWER_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# ANSWER_MODELS=moonshot-v1-8k

# ── Option D: Cloud Qwen (DashScope) for planning, Gemini for answers ─────────
# PLANNING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PLANNING_MODEL=qwen-turbo
