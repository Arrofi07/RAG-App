# .env.example — copy this to .env and fill in the required values
#
# REQUIRED
# ────────
GEMINI_API_KEY=your-gemini-api-key-here

# Generate a strong random secret (32+ chars) with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-real-secret-minimum-32-characters

# OPTIONAL — LLM provider routing
# ─────────────────────────────────
# Which provider handles each role.
# "ollama" uses local Qwen3 (free, private, slower).
# "gemini" uses Gemini API (costs quota, faster, better quality).
ENRICHMENT_PROVIDER=ollama
ENRICHMENT_MODEL=qwen3:1.7b

PLANNING_PROVIDER=ollama
PLANNING_MODEL=qwen3:1.7b

ANSWER_PROVIDER=gemini
ANSWER_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3.5-flash

# OPTIONAL — LLM retry tuning
LLM_MAX_RETRIES=2
LLM_503_BACKOFF=5

# OPTIONAL — Qdrant
QDRANT_URL=http://localhost:6333

# OPTIONAL — Ollama (when running locally, not via Docker)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# OPTIONAL — Embedding model
# Change only if you want a different model (requires re-ingesting all docs)
LOCAL_EMBED_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# OPTIONAL — HuggingFace
# Set to 1 after models are downloaded to avoid network checks on every start
HF_HUB_OFFLINE=0
# HF_TOKEN=your-huggingface-token   # enables higher download rate limits

# OPTIONAL — Context-aware retrieval
MAX_HISTORY_TURNS=10
